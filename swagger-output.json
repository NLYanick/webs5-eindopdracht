{
  "swagger": "2.0",
  "info": {
    "title": "Target Service",
    "description": "Target Service API documentation",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": ["http"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization"
    }
  },
  "paths": {
    "/api/v1/": {
      "get": {
        "description": "",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Login with username and password",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "properties": {
                "username": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["username", "password"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Login successful, returns JWT token" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Invalid credentials" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Register a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "properties": {
                "username": { "type": "string" },
                "password": { "type": "string" }
              },
              "required": ["username", "password"]
            }
          }
        ],
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/v1/targets/": {
      "get": {
        "description": "Get targets filtered by city or coordinates",
        "parameters": [
          { "name": "city", "in": "query", "type": "string", "description": "City name to filter targets" },
          { "name": "lat", "in": "query", "type": "number", "description": "Latitude coordinate" },
          { "name": "lng", "in": "query", "type": "number", "description": "Longitude coordinate" }
        ],
        "responses": {
          "200": { "description": "Targets found" },
          "400": { "description": "No valid query params provided" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "No targets found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "description": "Create a new target",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "properties": {
                "title": { "type": "string" },
                "organizerId": { "type": "string" },
                "photoUrl": { "type": "string" },
                "city": { "type": "string" },
                "lat": { "type": "number" },
                "lng": { "type": "number" },
                "radiusInMeter": { "type": "number" }
              },
              "required": ["title", "organizerId"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Target created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/api/v1/targets/{id}": {
      "delete": {
        "description": "Delete a target by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string", "description": "Target ID" },
          { "name": "authorization", "in": "header", "type": "string", "required": true }
        ],
        "responses": {
          "200": { "description": "Target deleted" },
          "400": { "description": "Invalid target ID" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Target not found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}